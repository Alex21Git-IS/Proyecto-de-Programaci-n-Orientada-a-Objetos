using System;
using System.Drawing;
using System.IO;
using System.Windows.Forms;

namespace Proyeto
{
    public partial class Form1 : Form
    {
        private Laberinto laberinto;

        public Form1()
        {
            InitializeComponent();
            this.KeyDown += Form1_KeyDown; //Indica si el formulario recibe los elementos
            this.KeyPreview = true; // Captura las teclas antes que los controles
        }

        // Evento para mover al jugador
        private void Form1_KeyDown(object sender, KeyEventArgs e)
        {
            if (laberinto == null) return;

            if (e.KeyCode == Keys.Up || e.KeyCode == Keys.W)
                laberinto.MoverJugador(-1, 0);
            else if (e.KeyCode == Keys.Down || e.KeyCode == Keys.S)
                laberinto.MoverJugador(1, 0);
            else if (e.KeyCode == Keys.Left || e.KeyCode == Keys.A)
                laberinto.MoverJugador(0, -1);
            else if (e.KeyCode == Keys.Right || e.KeyCode == Keys.D)
                laberinto.MoverJugador(0, 1);

            Invalidate(); // Redibuja el formulario
            e.SuppressKeyPress = true; // Evita movimiento doble
        }

        //Metodo que dibuja el laberinto en la interfaz gráfica
        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);

            if (laberinto != null)
            {
                laberinto.Dibujar(e.Graphics);

                // Mostrar contador de movimientos
                string textoMov = $"Movimientos: {laberinto.movimientos}";
                e.Graphics.DrawString(textoMov, new Font("Arial", 12, FontStyle.Bold), Brushes.White, new PointF(10, 10));
                // Metedo para mostrar el texto con el contador de movimientos 
            }
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            
        }

        /*Boton con el metodo para cargar el archivo*/
        private void buttonCargarArchivo_Click(object sender, EventArgs e)
        {
            //Metodo para cargar el cargar el archivo
            OpenFileDialog openFileDialog = new OpenFileDialog
            {
                Filter = "Archivos de texto (*.*)|*.*"
                //Filtro para definir que archivo cargar
            };

            //Mostrar el contenido del archivo y dibujarlo en el form
            if (openFileDialog.ShowDialog() == DialogResult.OK)
            {
                laberinto = new Laberinto(openFileDialog.FileName, this);
                Invalidate(); // Forzar dibujo
            }
        }
    }
}

